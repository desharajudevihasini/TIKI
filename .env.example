# Copy to .env, then set your own private Gemini API key.
GEMINI_API_KEY=
TIKI_AI_MODEL=auto
TIKI_DEMO_MODE=0
# Replace with the current ESP32 IP from Arduino Serial Monitor.
TIKI_ESP_URL=http://192.168.1.100
TIKI_MAC_BRIDGE=1
TIKI_MAC_TTS=1
TIKI_MAC_VOICE=Samantha
TIKI_MAC_TTS_RATE=190
TIKI_FAST_REPLIES=1
TIKI_WAKE_ENABLED=0
TIKI_REMINDERS_SPEAKER=1
TIKI_YOLO_ENABLED=0
TIKI_YOLO_MODEL=yolo11n.pt
